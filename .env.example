# gobit vitrin anahtarı (pk_…): gobit admin'de satış kanalına bağlı publishable key.
NEXT_PUBLIC_GOBIT_PUBLISHABLE_KEY=pk_your_publishable_api_key_here

# Tarayıcının gördüğü gobit adresi (görsel proxy'si /r2/ ve /files/ bunun üzerinden).
NEXT_PUBLIC_GOBIT_BACKEND_URL=http://localhost:9100

# Sunucunun gobit'e gittiği adres (Docker'da iç ağ adı); yoksa yukarıdaki kullanılır.
GOBIT_BACKEND_URL=http://localhost:9100

# Vitrinin satış kanalı (gobit admin → satış kanalları).
GOBIT_SALES_CHANNEL_ID=

# Varsayılan bölge (ülke kodu)
NEXT_PUBLIC_DEFAULT_REGION=tr

# Vitrinin kendi adresi (mutlak bağlantılar için)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# PayTR ödeme çerçevesinin adresi (yerelde sahte PayTR)
NEXT_PUBLIC_PAYTR_BASE_URL=https://www.paytr.com

# Google Analytics ölçüm kimliği, ör. G-XXXXXXX (isteğe bağlı)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Web Push — gobit'teki VAPID_PUBLIC_KEY ile aynı
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

NODE_ENV=development
